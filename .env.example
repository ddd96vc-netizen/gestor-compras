# Copia este fichero a ".env" y rellena los valores reales.
# El fichero .env NUNCA se sube a git (está en .gitignore).

# Clave aleatoria para firmar las sesiones.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria

# Contraseña de acceso a la aplicación
APP_PASSWORD=cambia-esta-contrasena

# Entorno: development | production | testing
FLASK_CONFIG=development

# Necesario solo si usas los comandos de la CLI de Flask
# (por ejemplo: flask init-db, flask run)
FLASK_APP=app
